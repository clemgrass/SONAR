; Engine configuration file.
; Generado a mano, no por el editor: así queda bajo control de versiones desde el
; primer commit y no depende de que alguien repita los mismos clics.

config_version=5

[application]

config/name="Sonar"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/main_scene="res://Main.tscn"

[dotnet]

project/assembly_name="Sonar.Game"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

; El layout está calculado para 1280x800. Con canvas_items la escena se escala entera al
; redimensionar en vez de recortarse, que en una pantalla HiDPI es la diferencia entre ver
; el scope completo y ver un cuarto de él.
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
